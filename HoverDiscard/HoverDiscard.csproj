<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <AssemblyName>HoverDiscard</AssemblyName>
    <RootNamespace>HoverDiscard</RootNamespace>
    <Authors>AlshainAql</Authors>
    <Copyright>Copyright (c) 2026 AlshainAql</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <Description>Collect inventory items by hovering and discard a reviewed selection.</Description>
    <PackageProjectUrl>https://github.com/AlshainAql/HoverDiscard</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HoverDiscard.Core/HoverDiscard.Core.csproj" />
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
